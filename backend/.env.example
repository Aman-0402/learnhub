DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL (default). Use DB_ENGINE=sqlite for quick local dev.
DB_ENGINE=mysql
DB_NAME=learnhub
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Payments: "mock" (default, no real charge) or "razorpay"
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (password reset). Default prints emails to the server console.
# For real delivery: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and fill in the SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=LearnHub <no-reply@learnhub.example>
FRONTEND_URL=http://localhost:5173

# Public address of the site (used in sitemap.xml). Defaults to FRONTEND_URL.
# SITE_URL=https://your-domain.com
# Production: redirect everything to HTTPS and send HSTS. Needs a proxy that sets X-Forwarded-Proto.
# FORCE_HTTPS=1
